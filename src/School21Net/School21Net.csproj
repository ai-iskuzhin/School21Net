<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>School21Net</RootNamespace>
    <AssemblyName>School21Net</AssemblyName>

    <!-- NuGet metadata (shared bits live in Directory.Build.props) -->
    <PackageId>School21Net</PackageId>
    <Description>Typed .NET client for the official School 21 public API (platform.21-school.ru): participants, projects and per-project participant lists (finished / in-reviews), campuses and coalitions. ROPC password-grant auth with transparent token caching.</Description>
    <PackageTags>school21;21-school;sdk;api-client;openapi</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon Condition="Exists('../../assets/logo.png')">logo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Condition="Exists('../../README.md')" />
    <None Include="../../assets/logo.png" Pack="true" PackagePath="/" Condition="Exists('../../assets/logo.png')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="School21Net.Tests" />
  </ItemGroup>

</Project>
